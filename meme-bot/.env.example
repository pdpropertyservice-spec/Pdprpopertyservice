# --- Wallet (LIVE mode only). Use a DEDICATED burner wallet funded with money you can afford to lose. ---
# Base58 private key exported from Phantom/Solflare. Never commit this file.
SOLANA_PRIVATE_KEY=

# Use a paid RPC (Helius/QuickNode/Triton) for live trading; the public one rate-limits and lands txs poorly.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Safety rails (SOL) ---
BUDGET_SOL=1.0              # bot never has more than this deployed (open cost basis) at once
POSITION_SOL=0.05           # size of each buy
MAX_OPEN_POSITIONS=4
DAILY_LOSS_LIMIT_SOL=0.2    # stop opening new trades after realized losses exceed this in a UTC day
MAX_CONSECUTIVE_LOSSES=4    # pause new entries after this many losing trades in a row
RESERVE_SOL=0.02            # kept untouched for fees / rent

# --- Exit rules ---
STOP_LOSS_PCT=30
TAKE_PROFIT_PCT=100         # sell TP_SELL_FRACTION of the position here
TP_SELL_FRACTION=0.5
TRAIL_ACTIVATE_PCT=40       # trailing stop arms once peak gain >= this
TRAIL_PCT=25                # sell the rest if price falls this % from peak
MAX_HOLD_MINUTES=120

# --- Entry filters ---
MIN_LIQUIDITY_USD=15000
MIN_VOLUME_H1_USD=20000
MIN_AGE_MINUTES=15
MAX_AGE_MINUTES=720
MIN_BUY_SELL_RATIO_M5=1.2
MIN_CHANGE_H1_PCT=10
MAX_CHANGE_H1_PCT=300
MAX_FDV_USD=5000000

# --- Execution ---
SLIPPAGE_BPS=300
MAX_ROUNDTRIP_LOSS_PCT=20   # reject if buy-then-immediately-sell quote loses more than this (honeypot / tax / thin pool)
PRIORITY_FEE_LAMPORTS=200000
POLL_SECONDS=15
